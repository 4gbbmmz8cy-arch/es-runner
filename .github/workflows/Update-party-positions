name: Update party positions

on:
  schedule:
    - cron: '17 * * * *'
  workflow_dispatch:
    inputs:
      backfill_days:
        description: 'Lookback window for official press releases (1-90 days)'
        required: false
        default: '7'
      dry_run:
        description: 'Validate sources without writing D1'
        required: false
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: everyside-party-positions
  cancel-in-progress: false

jobs:
  refresh:
    runs-on: ubuntu-latest
    environment: Prod
    env:
      PARTY_BACKFILL_DAYS: ${{ inputs.backfill_days || '7' }}
      PARTY_DRY_RUN: ${{ inputs.dry_run && '1' || '0' }}
      OPEN_AI_API_KEY: ${{ secrets.OPEN_AI_API_KEY }}
      GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
      OPENAI_MODEL: gpt-5.4-mini
      GEMINI_MODEL: gemini-3.5-flash-lite
      GEMINI_THINKING_LEVEL: low
      OPENAI_REASONING_EFFORT: low
      OPENAI_MAX_RETRIES: 1
      GEMINI_MAX_REQUESTS: 24
      CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
      CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
      CLOUDFLARE_D1_DATABASE_ID: ee9c5c9b-0790-49d9-8e3f-01ee9f33b78c
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Setup Node
        uses: actions/setup-node@v5
        with:
          node-version: 22
      - name: Install Puppeteer for official party websites
        run: npm install puppeteer --no-save
      - name: Install Chrome
        run: npx puppeteer browsers install chrome
      - name: Apply D1 schema
        run: npx wrangler@latest d1 execute story-homepage --remote --file=d1/schema.sql
      - name: Refresh party positions
        run: node scripts/update-party-positions.mjs
